rules_version = '2';

// Règles Firestore de Jàng (version 2.0).
// À coller dans la console Firebase : Firestore Database > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? me().get('role', 'student') : ''; }
    function isAdmin() { return role() == 'admin'; }
    function isStaff() { return role() in ['admin', 'prof', 'teacher']; }
    function canEdit() { return isAdmin() || (isStaff() && me().get('canEdit', false) == true); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function canReadStudent(uid) {
      return isAdmin()
             || (isStaff() && !isAdmin()
                 && exists(/databases/$(database)/documents/studentAccess/$(uid)/teachers/$(request.auth.uid)));
    }
    // Champs qu'un élève ne peut pas changer lui-même.
    function protectedFields() { return ['role', 'disabled', 'blocked', 'profSubjects', 'profExams', 'canEdit', 'deleted', 'school']; }
    function keepsProtected() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields());
    }

    // ---------- Comptes ----------
    match /users/{uid} {
      allow read: if isMe(uid) || canReadStudent(uid);
      allow create: if isMe(uid)
                    && (request.resource.data.get('role', 'student') == 'student'
                        ? !request.resource.data.keys().hasAny(['disabled', 'canEdit', 'profSubjects', 'profExams', 'school'])
                        : request.resource.data.get('role', '') == 'prof'
                          && request.resource.data.get('school', '') is string
                          && request.resource.data.school.size() > 0
                          && request.resource.data.get('profSubjects', []) is list
                          && request.resource.data.profSubjects.size() > 0
                          && request.resource.data.get('profExams', []) is list
                          && request.resource.data.profExams.size() > 0
                          && request.resource.data.get('canEdit', true) == false
                          && request.resource.data.keys().hasOnly(['name','username','role','examId','parentConsent','createdAt','school','profSubjects','profExams','canEdit']));
      allow update: if (isMe(uid) && keepsProtected()) || isAdmin()
                    || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled', 'blocked']));
      allow delete: if isAdmin();

      match /progress/{id} {
        allow read: if isMe(uid) || canReadStudent(uid);
        allow write: if isMe(uid);
        allow delete: if isMe(uid) || isStaff();
      }
      match /missions/{id} {
        allow read: if isMe(uid) || canReadStudent(uid);
        allow write: if isMe(uid);
        allow delete: if isMe(uid) || isStaff();
      }
      function wonStandardMatch(matchId) {
        let matchData = get(/databases/$(database)/documents/matchs/$(matchId)).data;
        return matchData.get('state', '') == 'fini'
               && matchData.get('tournamentId', '') == ''
               && request.auth.uid in matchData.get('winnerUids', []);
      }
      match /matchRewards/{matchId} {
        allow read: if isMe(uid);
        allow create: if isMe(uid) && wonStandardMatch(matchId)
                      && request.resource.data.get('sourceMatch', '') == matchId
                      && request.resource.data.get('milestone', 0) is int
                      && request.resource.data.milestone > 0
                      && request.resource.data.milestone % 5 == 0
                      && request.resource.data.keys().hasOnly(['sourceMatch','milestone','at']);
        allow update, delete: if false;
      }
      match /ndimbals/{tokenId} {
        allow read: if isMe(uid);
        allow create: if isMe(uid) && wonStandardMatch(tokenId)
                      && request.resource.data.get('sourceMatch', '') == tokenId
                      && existsAfter(/databases/$(database)/documents/users/$(uid)/matchRewards/$(tokenId))
                      && request.resource.data.keys().hasOnly(['sourceMatch','earnedAt','expiresAt']);
        allow update: if false;
        allow delete: if isMe(uid);
      }
      // Messages des profs à un élève.
      match /messages/{id} {
        allow read: if isMe(uid) || isAdmin()
                    || (isStaff() && resource.data.get('fromUid', '') == request.auth.uid);
        allow create: if isStaff()
                      && request.resource.data.get('fromUid', '') == request.auth.uid
                      && request.resource.data.get('toUid', '') == uid
                      && canReadStudent(uid)
                      && request.resource.data.get('text', '') is string;
        allow update: if isAdmin()
                      || (isMe(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'reply', 'replyAt']));
        allow delete: if isAdmin() || isMe(uid)
                      || (isStaff() && resource.data.get('fromUid', '') == request.auth.uid);
      }
    }

    // Anciennes demandes de professeurs (conservées pour les comptes créés avant l'inscription directe).
    match /teacherApplications/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.classNames is list
                    && request.resource.data.classNames.size() > 0
                    && request.resource.data.subjects is list
                    && request.resource.data.subjects.size() > 0
                    && request.resource.data.keys().hasOnly(['uid','name','school','classNames','subjects','examId','examName','status','createdAt']);
      allow update: if isAdmin()
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['approved','rejected']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt']);
      allow delete: if isAdmin();
    }

    // Index public minimal pour trouver un ami sans lire son profil complet.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.uid)
                    && request.resource.data.username == username
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if isMe(resource.data.uid);
    }

    // Demandes Xarit : seuls l'expéditeur et le destinataire y ont accès.
    match /friendRequests/{id} {
      allow read: if signedIn()
                  && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['fromUid','toUid','fromName','toName','status','createdAt']);
      allow update: if signedIn()
                    && resource.data.toUid == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted','rejected']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Invitations privées à rejoindre un match Xarit.
    match /matchInvitations/{id} {
      allow read: if signedIn()
                  && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && get(/databases/$(database)/documents/matchs/$(request.resource.data.matchId)).data.hostUid == request.auth.uid
                    && get(/databases/$(database)/documents/matchs/$(request.resource.data.matchId)).data.open == true
                    && request.resource.data.keys().hasOnly(['fromUid','toUid','fromName','matchId','code','status','createdAt']);
      allow update: if signedIn()
                    && resource.data.toUid == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted','declined']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Parties de Ludo Jàng : le code numérique identifie la salle.
    match /ludoGames/{code} {
      allow read: if signedIn()
                  && (!exists(/databases/$(database)/documents/ludoGames/$(code))
                      || request.auth.uid in resource.data.get('playerUids', [])
                      || resource.data.get('status', '') == 'waiting');
      allow create: if signedIn()
                    && request.resource.data.get('code', '') == code
                    && request.resource.data.get('hostUid', '') == request.auth.uid
                    && request.resource.data.get('playerUids', []) == [request.auth.uid]
                    && request.resource.data.get('status', '') == 'waiting'
                    && request.resource.data.get('questions', []) is list
                    && request.resource.data.get('pawns', []) is list;
      allow update: if signedIn()
                    && (
                      (resource.data.get('status', '') == 'waiting'
                       && !(request.auth.uid in resource.data.get('playerUids', []))
                       && request.auth.uid in request.resource.data.get('playerUids', [])
                       && request.resource.data.playerUids.size() == resource.data.playerUids.size() + 1
                       && request.resource.data.playerNames.size() == resource.data.playerNames.size() + 1
                       && request.resource.data.get('status', '') == 'playing'
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerUids','playerNames','status','message','questionDeadline','waitingForSquareQuestion','resolvingQuestion']))
                      || (request.auth.uid in resource.data.get('playerUids', [])
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'questionIndex','questionDeadline','waitingForSquareQuestion','resolvingQuestion','pendingPawnIndex','pendingOrigin','pendingTarget',
                            'turn','streaks','missesSinceSix','die','rollingPlayer','message','done','shieldAvailable','pawns','shieldedPawns'
                          ]))
                    );
      allow delete: if signedIn() && resource.data.get('hostUid', '') == request.auth.uid;
    }

    // ---------- Contenus ----------
    match /exams/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if true; allow write: if canEdit(); }
    match /chapters/{id} { allow read: if true; allow write: if canEdit(); }
    match /lessons/{id} { allow read: if true; allow write: if canEdit(); }
    match /flashcards/{id} { allow read: if true; allow write: if canEdit(); }
    match /media/{id} { allow read: if true; allow write: if canEdit(); }

    // Accueil, contact, adresse du serveur de notifications.
    match /config/{id} { allow read: if true; allow write: if isAdmin(); }

    // Espace de développement professionnel réservé aux professeurs et à l'administration.
    match /teacherPosts/{postId} {
      function canSeePost() {
        return isAdmin()
          || (signedIn() && resource.data.get('type', '') == 'tip')
          || (role() == 'prof'
              && (resource.data.get('targetSubject', '') == ''
                  || resource.data.get('targetSubject', '') in me().get('profSubjects', [])));
      }
      allow read: if canSeePost();
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && ((isAdmin() && request.resource.data.type == 'resource')
                        || (role() == 'prof' && request.resource.data.type == 'tip'));
      allow update, delete: if isAdmin()
                            || (role() == 'prof' && resource.data.authorUid == request.auth.uid
                                && resource.data.type == 'tip');
    }

    // ---------- Vie de la classe ----------
    match /annonces/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
                    || (role() == 'prof'
                        && request.resource.data.get('audience', 'students') == 'students'
                        && request.resource.data.get('fromUid', '') == request.auth.uid
                        && request.resource.data.get('subject', '') in me().get('profSubjects', [])
                        && (request.resource.data.get('examId', '') == ''
                            || request.resource.data.examId in me().get('profExams', [])));
      allow update, delete: if isAdmin()
                            || (role() == 'prof' && resource.data.get('fromUid', '') == request.auth.uid);
      match /lus/{uid} {
        allow read: if isAdmin() || isMe(uid);
        allow write: if isMe(uid);
      }
    }

    // Moutons : prénom (ou caché), nom du mouton, total de la semaine.
    match /moutons/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
      allow delete: if isMe(uid) || isAdmin();
    }

    match /comments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('uid', request.auth.uid) == request.auth.uid;
      allow update: if isAdmin()
                    || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'answered']));
      allow delete: if isAdmin() || (signedIn() && resource.data.get('uid', '') == request.auth.uid);
    }

    // Missions avec Gaïndé modifiées par l'admin.
    match /missionEdits/{id} { allow read: if true; allow write: if isAdmin(); }

    // ---------- Classes ----------
    function onlyMe(after, before) {
      // Seul l'élève connecté est ajouté ou retiré de la liste.
      return after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
          && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }
    function onlyRemoves(after, before) { return after.toSet().difference(before.toSet()).size() == 0; }
    function onlyStudents() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students']); }
    function classOf(id) { return get(/databases/$(database)/documents/classes/$(id)).data; }

    match /classes/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
                    || (signedIn()
                        && role() == 'prof'
                        && request.resource.data.profUid == request.auth.uid
                        && request.resource.data.school == me().get('school', '')
                        && request.resource.data.get('students', []) is list
                        && request.resource.data.students.size() == 0);
      allow delete: if isAdmin() || (isStaff() && resource.data.profUid == request.auth.uid);
      allow update: if isAdmin()
                    || (isStaff() && resource.data.profUid == request.auth.uid)
                    // un prof retire un élève qui change de classe dans la même matière
                    || (isStaff() && resource.data.profUid == request.auth.uid
                        && onlyStudents() && onlyRemoves(request.resource.data.students, resource.data.students))
                    // l'élève entre ou sort avec le code
                    || (signedIn() && onlyStudents() && onlyMe(request.resource.data.students, resource.data.students));
    }

    // Un professeur ne peut consulter les données d'un élève que si celui-ci est dans sa classe.
    // Les liens sont créés automatiquement à l'inscription dans une classe ou à l'ajout par le prof.
    match /studentAccess/{uid}/teachers/{profUid} {
      function linkedClass() {
        return get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data;
      }
      function validLink() {
        return request.resource.data.get('profUid', '') == profUid
               && linkedClass().profUid == profUid
               && uid in linkedClass().get('students', []);
      }
      allow read: if signedIn() && (isMe(uid) || isMe(profUid) || isAdmin());
      allow create, update: if signedIn() && validLink() && (isMe(uid) || isMe(profUid) || isAdmin());
      allow delete: if signedIn() && (isMe(uid) || isMe(profUid) || isAdmin());
    }

    // Journal administratif des exports de leçons officielles vers les classes.
    match /courseExports/{id} {
      allow read: if isAdmin();
      allow create: if isStaff()
                    && request.resource.data.exportedBy == request.auth.uid
                    && request.resource.data.classId is string
                    && (isAdmin() || classOf(request.resource.data.classId).profUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Contenus des profs : privés (élèves de la classe) ou publics (tous).
    match /classItems/{id} {
      allow read: if isAdmin()
                  || (isStaff() && classOf(resource.data.classId).profUid == request.auth.uid)
                  || (signedIn() && resource.data.visibility == 'public')
                  || (signedIn() && request.auth.uid in classOf(resource.data.classId).students);
      allow create: if isStaff() && request.resource.data.ownerUid == request.auth.uid
                    && (isAdmin() || classOf(request.resource.data.classId).profUid == request.auth.uid);
      allow update, delete: if isAdmin()
                            || (isStaff() && resource.data.ownerUid == request.auth.uid
                                && classOf(resource.data.classId).profUid == request.auth.uid);

      // Devoirs rendus : seul l'élève de la classe ou son professeur peut les consulter.
      match /rendus/{uid} {
        function parentItem() {
          return get(/databases/$(database)/documents/classItems/$(id)).data;
        }
        function classRoom() {
          return get(/databases/$(database)/documents/classes/$(parentItem().classId)).data;
        }
        function ownsClass() {
          return isAdmin() || (isStaff() && classRoom().profUid == request.auth.uid);
        }
        function isEnrolled() {
          return request.auth.uid in classRoom().get('students', []);
        }
        function beforeDeadline() {
          let due = parentItem().get('dueAt', null);
          return due == null || request.time <= due;
        }
        allow read: if isMe(uid) || ownsClass();
        allow create: if isMe(uid) && isEnrolled()
                      && request.resource.data.get('classId', '') == parentItem().classId
                      && beforeDeadline()
                      && !request.resource.data.keys().hasAny(['grade', 'comment', 'gradedAt']);
        allow update: if (isMe(uid) && isEnrolled() && beforeDeadline()
                          && resource.data.get('grade', '') == '' && resource.data.get('comment', '') == ''
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'text', 'classId', 'at']))
                      || (ownsClass()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade', 'comment', 'gradedAt']));
      }
    }

    // ---------- Matchs en direct ----------
    // Version compatible avec Firebase Spark : les résultats restent dans Firestore.
    // Les membres authentifiés peuvent lire les questions, réponses et scores.
    match /matchAnswers/{matchId} {
      allow read, write: if false;
    }

    match /matchs/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.questions is list
                    && (request.resource.data.get('classId', '') == ''
                        || (classOf(request.resource.data.classId).profUid == request.auth.uid
                            && classOf(request.resource.data.classId).get('deleted', false) != true));
      allow update: if signedIn()
                    && resource.data.hostUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /joueurs/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid)
                      && request.resource.data.get('uid', uid) == uid
                      && request.resource.data.get('score', 0) == 0;
        allow update: if isMe(uid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['answers','score','reaction']);
        allow delete: if isMe(uid)
                      && get(/databases/$(database)/documents/matchs/$(id)).data.get('state', '') == 'attente';

        match /reponses/{questionId} {
          allow read, write: if false;
        }
      }

      match /observateurs/{uid} {
        function host() {
          return signedIn()
              && get(/databases/$(database)/documents/matchs/$(id)).data.hostUid == request.auth.uid;
        }
        function matchData() { return get(/databases/$(database)/documents/matchs/$(id)).data; }
        allow read: if isMe(uid) || host() || resource.data.get('status', '') == 'accepted';
        allow create: if isMe(uid)
                      && request.resource.data.get('status', '') in ['pending', 'accepted']
                      && (request.resource.data.get('status', '') == 'pending'
                          ? matchData().get('state', '') in ['question', 'correction']
                          : matchData().get('tournamentId', '') != ''
                            && matchData().get('state', '') in ['attente', 'question', 'correction'])
                      && matchData().get('open', false) == true
                      && !exists(/databases/$(database)/documents/matchs/$(id)/joueurs/$(uid));
        allow update: if host()
                      && resource.data.get('status', '') == 'pending'
                      && request.resource.data.get('status', '') in ['accepted', 'refused']
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if isMe(uid) || host();
      }
    }

    // Les corrigés des tournois sont privés aux fonctions serveur.
    match /tournamentAnswers/{tournamentId} {
      allow read, write: if false;
    }

    // Tournois à élimination : seuls les champs publics du tableau sont lisibles.
    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.questions is list;
      allow update: if signedIn()
                    && resource.data.hostUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status','round','championUid','championName']);
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /participants/{uid} {
        function parentTournament() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if signedIn();
        allow create: if isMe(uid)
                      && parentTournament().status == 'waiting'
                      && (parentTournament().get('classId', '') == ''
                          || uid in classOf(parentTournament().classId).get('students', []))
                      && request.resource.data.keys().hasOnly(['name','joinedAt']);
        allow update: if isMe(uid)
                      && parentTournament().status == 'waiting'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
        allow delete: if (isMe(uid) && parentTournament().status == 'waiting')
                      || (signedIn() && parentTournament().hostUid == request.auth.uid);
      }

      match /rounds/{roundId} {
        function organizer() {
          return signedIn()
              && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostUid == request.auth.uid;
        }
        allow read: if signedIn();
        allow create, update, delete: if organizer();

        match /games/{gameId} {
          allow read: if signedIn();
          allow create: if signedIn()
                        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostUid == request.auth.uid;
          allow update: if signedIn()
                        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostUid == request.auth.uid;
          allow delete: if signedIn()
                        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostUid == request.auth.uid;
        }
      }
    }

    // Questions de match signalées.
    match /signalements/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // ---------- Statistiques et journaux ----------
    match /statsLessons/{id} { allow read: if isStaff(); allow write: if signedIn(); }
    match /statsDays/{id} { allow read: if isStaff(); allow write: if signedIn(); }
    match /tutorLogs/{id} {
      allow read: if isAdmin() || canReadStudent(resource.data.get('uid', ''));
      allow delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.get('uid', '') == request.auth.uid;
    }
    match /journal/{id} { allow read: if isAdmin(); allow create: if isStaff(); }

    // File d'attente des notifications de nuit : seul le serveur (compte de service) y touche.
    match /pushQueue/{id} { allow read, write: if false; }
  }
}


